# Copy to .env.local and fill in. Both are optional — the app falls back to
# safe defaults if unset — but you should set them in production.

# Your own OCR.space API key (https://ocr.space/ocrapi). Falls back to the
# shared public free-tier key if omitted.
OCR_SPACE_API_KEY=

# Secret used to encrypt the ERP session token that round-trips through the
# browser. Use a long random string (e.g. `openssl rand -hex 32`). If unset,
# sessions fall back to plain base64 (not encrypted).
SESSION_SECRET=
